# Copia este archivo a `.env` para cambiar la configuración por defecto.
# docker compose lee `.env` automáticamente.

# --- Modelos ---------------------------------------------------------------
# qwen2.5:7b  -> mejor calidad y tool calling fiable (~4.7 GB)
# qwen2.5:3b  -> ~3x más rápido en CPU, útil para demos en vivo (~2 GB)
# qwen2.5:14b -> mejor razonamiento, necesita bastante RAM (~9 GB)
LLM_MODEL=qwen2.5:7b

# Modelo de embeddings (768 dimensiones, ~275 MB).
# IMPORTANTE: si lo cambias, hay que reindexar con `ingest --reset`, porque los
# vectores viejos pertenecen a otro espacio vectorial.
EMBED_MODEL=nomic-embed-text

# 0.0 = determinista. En RAG conviene bajo para no inventar.
TEMPERATURE=0.1

# --- Base vectorial --------------------------------------------------------
CHROMA_COLLECTION=documentos

# --- Fragmentación e indexado ----------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVER_K=4
